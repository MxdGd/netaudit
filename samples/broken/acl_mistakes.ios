hostname edge1
!
ip access-list extended BLOCK_WEB
 deny tcp 192.168.1.0 255.255.255.0 any eq 80
 permit ip any any
 deny tcp any any eq 23
!
ip access-list extended UNUSED
 permit ip any any
!
interface GigabitEthernet0/0
 ip address 192.168.1.1 255.255.255.0
 ip access-group BLOCK_WEB in
 ip access-group GHOST out
!
end
